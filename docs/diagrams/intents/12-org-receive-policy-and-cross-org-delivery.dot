digraph org_receive_policy {
    rankdir=TB;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    // Sender Org
    subgraph cluster_sender {
        label="Sender Org (Org A)";
        style=filled; fillcolor="#e8f4fd"; color="#1a73e8";
        sender [label="Sender Agent\nagent://org-a/ws/requester", fillcolor="#bbdefb"];
        gw_send [label="Gateway\nPOST /v1/intents", fillcolor="#bbdefb"];
    }

    // Receiver Org
    subgraph cluster_receiver {
        label="Receiver Org (Org B)";
        style=filled; fillcolor="#fce8e6"; color="#d93025";

        subgraph cluster_policy {
            label="Policy Evaluation";
            style=filled; fillcolor="#fef7e0"; color="#f9ab00";
            rp [label="Org Receive Policy\norg_receive_policies", shape=diamond, fillcolor="#fff9c4"];
            allow [label="✓ Allow", fillcolor="#c8e6c9", color="#1e8e3e"];
            deny [label="✗ Deny 403", fillcolor="#ffcdd2", color="#d93025"];
            al_check [label="Sender org_id\nin allowlist?", shape=diamond, fillcolor="#fff9c4"];
            override [label="Agent Receive Override\nagent_receive_overrides", shape=diamond, fillcolor="#fff9c4"];
        }

        receiver [label="Receiver Agent\nagent://org-b/ws/processor", fillcolor="#ffcdd2"];
    }

    // Flow
    sender -> gw_send [label="cross-org intent"];
    gw_send -> rp [label="to_agent in\ndifferent org"];
    rp -> allow [label="mode=open"];
    rp -> deny [label="mode=closed"];
    rp -> al_check [label="mode=allowlist"];
    al_check -> allow [label="yes"];
    al_check -> override [label="no"];
    override -> allow [label="override=allow\nfor this agent"];
    override -> deny [label="no override"];
    allow -> receiver;
    deny -> sender [label="HTTP 403", style=dashed, color="#d93025"];

    // Tables
    subgraph cluster_tables {
        label="Database Tables";
        style=filled; fillcolor="#e6f4ea"; color="#1e8e3e";
        t1 [label="org_receive_policies\n─────────────────\norg_id (PK)\nmode: open│allowlist│closed\nallowlist_json\ncreated_at, updated_at", shape=record, fillcolor="#c8e6c9"];
        t2 [label="agent_receive_overrides\n─────────────────\nagent_address (PK)\noverride_org_id\noverride_type: allow│block\ncreated_at, updated_at", shape=record, fillcolor="#c8e6c9"];
    }
}
