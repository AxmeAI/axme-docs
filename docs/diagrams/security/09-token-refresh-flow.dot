digraph token_refresh {
    graph [pad="0.5" nodesep="0.6" ranksep="0.7"];
    rankdir=TB
    node [shape=box fontname="monospace" fontsize=11]
    edge [fontname="monospace" fontsize=10]

    CHK   [label="Check JWT exp − now"]
    SOON  [label="exp − now < 60s?" shape=diamond]
    SKIP  [label="Token still valid → proceed with request" style=filled fillcolor=lightgray]
    RREQ  [label="POST /v1/auth/refresh\n{ refresh_token } + x-api-key"]
    VREF  [label="Validate refresh_token\none-time-use, 30-day TTL" shape=diamond]
    F401R [label="401 invalid_refresh_token\n→ prompt: axme login" style=filled fillcolor=lightyellow]
    ROT   [label="Rotate: new access_token (15 min)\n+ new refresh_token (30 day)\nold token invalidated immediately" style=filled fillcolor=lightblue]
    RTOK  [label="Return { access_token, refresh_token,\nexpires_in: 900 }" style=filled fillcolor=lightgreen]
    SAVE  [label="Persist new tokens to secret store"]

    { rank=same SKIP RREQ }
    { rank=same F401R VREF }
    { rank=same ROT }
    { rank=same RTOK }
    { rank=same SAVE }

    CHK  -> SOON
    SOON -> SKIP  [label="no (still valid)"]
    SOON -> RREQ  [label="yes (< 60s)"]
    RREQ -> VREF
    VREF -> F401R [label="invalid/expired"]
    VREF -> ROT   [label="valid"]
    ROT  -> RTOK
    RTOK -> SAVE
}
