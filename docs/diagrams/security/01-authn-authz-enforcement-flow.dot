digraph authn_authz {
    graph [pad="0.5" nodesep="0.6" ranksep="0.7"];
    rankdir=TB
    node [shape=box fontname="monospace" fontsize=11]
    edge [fontname="monospace" fontsize=10]

    REQ   [label="Incoming Request"]
    AKEY  [label="Validate machine key\nx-api-key (AXME_API_KEY)"]
    F401A [label="401 missing/invalid x-api-key" style=filled fillcolor=lightyellow]
    BRTE  [label="Actor token\nrequired on route?" shape=diamond]
    VJWT  [label="Validate actor token\nJWT sig + claims + scope"]
    F401B [label="401/403 missing actor token\nor invalid actor scope" style=filled fillcolor=lightyellow]
    OWNR  [label="Owner scope checks"]
    F403A [label="403 owner mismatch" style=filled fillcolor=lightyellow]
    ROLE  [label="Role or delegated grant\nallows action?" shape=diamond]
    F403B [label="403 forbidden" style=filled fillcolor=lightyellow]
    EXEC  [label="Execute endpoint logic"]
    AUDIT [label="Emit audit + trace metadata" style=filled fillcolor=lightgreen]

    { rank=same REQ AKEY }
    { rank=same BRTE F401A }
    { rank=same VJWT OWNR }
    { rank=same F401B F403A ROLE }
    { rank=same F403B EXEC }
    { rank=same AUDIT }

    REQ   -> AKEY
    AKEY  -> F401A [label="fail"]
    AKEY  -> BRTE  [label="ok"]
    BRTE  -> VJWT  [label="yes"]
    BRTE  -> OWNR  [label="no"]
    VJWT  -> F401B [label="fail"]
    VJWT  -> OWNR  [label="ok"]
    OWNR  -> F403A [label="fail"]
    OWNR  -> ROLE  [label="ok"]
    ROLE  -> F403B [label="deny"]
    ROLE  -> EXEC  [label="allow"]
    EXEC  -> AUDIT
}
